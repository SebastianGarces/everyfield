                "null"
              ]
            }
          },
          "anyOf": [
            {
              "required": [
                "result"
              ]
            },
            {
              "required": [
                "error_code"
              ]
            }
          ],
          "additionalProperties": false
        },
        "subcases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/subcase"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
