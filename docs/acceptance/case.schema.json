            "zone"
          ],
          "properties": {
            "now": {
              "type": "string",
              "format": "date-time"
            },
            "zone": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "action": {
          "type": "object",
          "required": [
