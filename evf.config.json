{
	"baseBranch": "main",
	"remote": "origin",
	"worktreeDir": ".worktrees",
	"statusContext": "evf/verify",
	"maxAgentsMdLines": 150,
	"stack": {
		"usesPaidProviders": false,
		"up": ["node", "scripts/stack.mjs", "up"],
		"status": ["node", "scripts/stack.mjs", "status"],
		"down": ["node", "scripts/stack.mjs", "down"]
	},
	"checks": [
		{
			"name": "workflow-regressions",
			"run": ["bin/evf", "test"]
		},
		{
			"name": "documentation",
			"run": ["python3", "docs/check-all.py"]
		},
		{
			"name": "local-app",
			"run": ["corepack", "pnpm", "check"]
		},
		{
			"name": "package-unit-tests",
			"run": ["corepack", "pnpm", "-r", "--if-present", "test:unit"]
		},
		{
			"name": "format",
			"run": ["corepack", "pnpm", "format:check"]
		}
	],
	"principles": {
		"repo": "cursor/plugins",
		"path": "pstack/skills",
		"prefix": "principle-",
		"ref": "main",
		"license": "pstack/LICENSE",
		"checkEveryDays": 7
	},
	"feedback": {
		"repo": null,
		"botAuthor": null,
		"triageAuthors": [],
		"dailyFixLimit": 3,
		"internalLabel": "from-feedback",
		"triageCron": "0 13 * * *",
		"botAuthorId": null,
		"triageActorIds": [],
		"startApprovals": [],
		"overLimitApprovals": [],
		"ownerActorIds": [],
		"promotionApprovals": [],
		"replyApprovals": {},
		"publicAreas": [],
		"publicTemplates": []
	},
	"mergePolicy": {
		"ordinary": "automatic-after-independent-review",
		"feedbackVerifierMerge": ["p0", "p1"],
		"feedbackOwnerAfterVerifier": ["p2", "p3"],
		"feedbackPrototypes": "owner-merge",
		"humanApproved": "evf-approve-after-owner-chat-approval",
		"ordinaryApproval": {
			"sourceMessageId": "Sentinel_ba84c52d1db0819187f0c9dd1a1c0165",
			"approvedAtUtc": "2026-10-13T23:37:00Z",
			"scope": "Ordinary build PRs only, after required final-head tests, independent approved review and applicable gates; no app kickoff or external setup authority."
		},
		"feedbackApproval": {
			"approvedAtUtc": "2026-10-16T01:27:45Z",
			"scope": "P0 and P1 feedback bug fixes merge through the cross-model verifier like ordinary builds. P2 and P3 get the same full verification, then wait for Sebastian's chat approval before an agent merges them with evf approve. Prototypes need Sebastian's approval."
		},
		"wikiApproval": {
			"approvedAtUtc": "2026-10-15T18:52:26Z",
			"scope": "Wiki article PRs never merge automatically and need no evf/verify; the Wiki workflow's own Opus review is their check. After Sebastian approves a PR in chat, the agent merges it with evf approve."
		},
		"sensitive": "owner-escalation-required"
	},
	"maintenanceTasks": {
		"OPS-1": {
			"title": "Phase 7 follow-ups",
