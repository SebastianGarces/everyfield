{
  "baseBranch": "main",
  "remote": "origin",
  "worktreeDir": ".worktrees",
  "statusContext": "evf/verify",
  "maxAgentsMdLines": 150,
  "stack": null,
  "checks": [
    {
      "name": "evf-doctor",
      "run": [
        "bin/evf",
        "doctor",
        "--here"
      ]
    },
    {
      "name": "build-explorer",
      "run": [
        "python3",
        "docs/update-build-explorer.py",
        "--root",
        ".",
        "--check"
      ]
    }
  ],
  "principles": {
    "repo": "cursor/plugins",
    "path": "pstack/skills",
    "prefix": "principle-",
    "ref": "main",
    "license": "pstack/LICENSE",
    "checkEveryDays": 7
  },
  "feedback": {
    "repo": null,
    "botAuthor": null,
    "triageAuthors": [],
    "dailyFixLimit": 3,
    "internalLabel": "from-feedback",
    "triageCron": "0 13 * * *"
  }
}
