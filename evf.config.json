{
  "baseBranch": "main",
  "remote": "origin",
  "worktreeDir": ".worktrees",
  "statusContext": "evf/verify",
  "maxAgentsMdLines": 150,
  "stack": null,
  "checks": [
    {
      "name": "workflow-regressions",
      "run": [
        "{node}",
        "--test",
        "tools/evf/tests/reconciliation.test.ts"
      ]
    },
    {
      "name": "current-context",
      "run": [
        "python3",
        "docs/package-context.py",
        "--check-manifest"
      ]
    },
    {
      "name": "build-explorer",
      "run": [
        "python3",
        "docs/update-build-explorer.py",
        "--root",
        ".",
        "--check"
      ]
    }
  ],
  "principles": {
    "repo": "cursor/plugins",
    "path": "pstack/skills",
    "prefix": "principle-",
    "ref": "main",
    "license": "pstack/LICENSE",
    "checkEveryDays": 7
  },
  "feedback": {
    "repo": null,
    "botAuthor": null,
    "triageAuthors": [],
    "dailyFixLimit": 3,
    "internalLabel": "from-feedback",
    "triageCron": "0 13 * * *",
    "botAuthorId": null,
    "triageActorIds": [],
    "startApprovals": [],
    "overLimitApprovals": [],
    "ownerActorIds": [],
    "promotionApprovals": [],
    "replyApprovals": {},
    "publicAreas": [],
    "publicTemplates": []
  },
  "verification": {
    "kind": "tooling",
    "applicationQualified": false,
    "attest": null,
    "usesPaidProviders": false,
    "proofPlans": {}
  },
  "mergePolicy": {
    "ordinary": "pending-owner-decision",
    "feedback": "human-reviewed",
    "humanActorIds": []
  }
}
