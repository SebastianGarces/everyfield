{
	"$schema": "https://unpkg.com/knip@6.43.0/schema-jsonc.json",
	"ignoreExportsUsedInFile": true,
	"workspaces": {
		".": {
			"entry": [
				"tests/**/*.{js,mjs,cjs,ts,mts,cts,tsx}",
				"scripts/**/*.{js,mjs,cjs,ts,mts,cts}",
				"tools/**/*.{js,mjs,cjs,ts,mts,cts}",
				"ops/**/*.{js,mjs,cjs,ts,mts,cts}",
				"docs/**/*.{js,mjs,cjs,ts,mts,cts}",
				".agents/**/*.{js,mjs,cjs,ts,mts,cts}",
				".github/**/*.{js,mjs,cjs,ts,mts,cts}",
			],
			"project": ["**/*.{js,mjs,cjs,ts,mts,cts,tsx}"],
		},
		"apps/web": {
			"entry": ["scripts/**/*.{js,mjs,cjs,ts,mts,cts}"],
		},
		"packages/contracts": {
			"entry": ["src/**/*.test.{ts,mts,tsx}"],
		},
		"packages/db": {
			"entry": ["scripts/**/*.{js,mjs,cjs,ts,mts,cts}", "src/schema/check-current.ts"],
		},
		"packages/domain": {
			"entry": ["test/**/*.{js,mjs,cjs,ts,mts,cts,tsx}", "scripts/**/*.{js,mjs,cjs,ts,mts,cts}"],
		},
		"packages/reference": {
			"entry": ["*.{js,mjs,cjs}"],
		},
	},
}
