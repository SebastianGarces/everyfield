{
	"name": "@everyfield/reference",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./server": "./src/server.ts"
	},
	"scripts": {
		"test:unit": "node src/build.mjs --check && node --test ../../tests/integration/reference/*.test.mjs ../../tests/reference/releases/*.test.mts",
		"test:db": "node --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test ../../tests/reference/releases/*.db.mts",
		"typecheck": "tsc --noEmit",
		"lint": "cd ../.. && packages/reference/node_modules/.bin/eslint --config packages/reference/eslint.config.mjs --max-warnings=0 packages/reference/src tests/reference/releases",
		"verify": "node verify.mjs",
		"freeze": "node src/build.mjs --write"
	},
	"dependencies": {
		"pg": "^8.16.3",
		"server-only": "0.0.1",
		"@mdx-js/mdx": "3.1.1",
		"zod": "4.6.7",
		"@everyfield/contracts": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^24",
		"@types/pg": "^8.15.6",
		"typescript": "6.0.3",
		"eslint": "^9.39.0",
		"typescript-eslint": "^8.57.0"
	}
}
