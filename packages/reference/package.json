{
	"name": "@everyfield/reference",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./playbook": "./src/playbook.ts"
	},
	"scripts": {
		"test:unit": "node src/build.mjs --check && node src/starter/manifest/pin.mjs --check && node --test ${EVF_NODE_TEST_FLAGS:-} ../../tests/integration/reference/*.test.mjs ../../tests/reference/releases/*.test.mts ../../tests/reference/starter/*.test.mts",
		"wiki:install": "node --conditions=react-server --env-file-if-exists=../../apps/web/.env.local src/starter/verify/cli.ts",
		"typecheck": "../../node_modules/.bin/bun check --no-script --no-pretty --all",
		"typecheck:tsc": "../../node_modules/typescript-7/bin/tsc --noEmit",
		"lint": "cd ../.. && packages/reference/node_modules/.bin/oxlint -c .oxlintrc.json --max-warnings=0 packages/reference/src tests/reference/releases tests/reference/starter",
		"verify": "node verify.mjs",
		"freeze": "node src/build.mjs --write"
	},
	"dependencies": {
		"@everyfield/contracts": "workspace:*",
		"@everyfield/db": "workspace:*",
		"@mdx-js/mdx": "3.1.1",
		"server-only": "0.0.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"typescript": "6.0.3",
		"oxlint": "1.92.0"
	}
}
