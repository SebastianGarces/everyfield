{
	"name": "@everyfield/db",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema/index.ts",
		"./auth-storage": "./src/schema/auth-storage.ts",
		"./client": "./src/client.ts",
		"./tables": "./src/schema/tables.ts",
		"./query": "./src/query.ts",
		"./columns": "./src/columns.ts",
		"./migrate": "./src/schema/migrate.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "eslint --max-warnings=0 .",
		"export": "tsx --env-file-if-exists=../../apps/web/.env.local scripts/export.ts",
		"reset:dev": "tsx --env-file-if-exists=../../apps/web/.env.local scripts/reset-dev.ts",
		"test:unit": "node --test ../../tests/integration/db/unit.test.mts ../../tests/integration/db/normalize.test.mts && pnpm schema:check",
		"test:db": "tsx --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test ../../tests/integration/db/baseline.test.mts ../../tests/integration/db/task-assignees.test.mts",
		"generate": "tsx scripts/generate.ts",
		"catalog": "tsx scripts/catalog.ts",
		"schema:check": "tsx scripts/catalog.ts --check && tsx scripts/check-migrations.ts"
	},
	"dependencies": {
		"pg": "^8.16.3",
		"server-only": "0.0.1",
		"@aws-sdk/client-s3": "3.1152.0",
		"@aws-sdk/s3-request-presigner": "3.1152.0",
		"sharp": "0.35.5",
		"pdfjs-dist": "6.4.299",
		"zod": "4.6.7",
		"drizzle-orm": "0.45.4"
	},
	"devDependencies": {
		"@types/node": "^24",
		"typescript": "6.0.3",
		"eslint": "^9.39.0",
		"typescript-eslint": "^8.57.0",
		"tsx": "^4.21.0",
		"@types/pg": "^8.15.6",
		"drizzle-kit": "0.31.11"
	}
}
