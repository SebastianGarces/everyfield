{
  "name": "@everyfield/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./auth-storage": "./src/schema/auth-storage.ts",
    "./client": "./src/client.ts",
    "./tables": "./src/schema/tables.ts",
    "./query": "./src/query.ts",
    "./columns": "./src/columns.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "migrate": "tsx --env-file-if-exists=../../apps/web/.env.local scripts/migrate.ts",
    "export": "tsx --env-file-if-exists=../../apps/web/.env.local scripts/export.ts",
    "reset:dev": "tsx --env-file-if-exists=../../apps/web/.env.local scripts/reset-dev.ts",
    "test:unit": "node --test ../../tests/integration/db/unit.test.mts && python3 src/schema/generate.py --check",
    "test:db": "tsx --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test ../../tests/integration/db/baseline.test.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "drizzle-orm": "0.45.4",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.16.3",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.0",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.57.0"
  }
}
