{
	"name": "@everyfield/evry",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./tracing": "./src/runtime/trace.ts"
	},
	"scripts": {
		"typecheck": "../../node_modules/typescript-7/bin/tsc --noEmit",
		"typecheck:bun": "../../node_modules/.bin/bun check --no-script --no-pretty --all",
		"lint": "oxlint -c ../../.oxlintrc.json --max-warnings=0 .",
		"test:unit": "node --conditions=react-server --test ${EVF_NODE_TEST_FLAGS:-} ../../tests/evry/catalog/catalog.test.mts ../../tests/evry/evals/classify.test.mts",
		"test:db": "node --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test --test-concurrency=1 ../../tests/evry/runtime/*.test.mts ../../tests/evry/execution/*.test.mts ../../tests/evry/adapters/people/reads/*.test.mts ../../tests/evry/adapters/people/commands/*.test.mts ../../tests/evry/adapters/communication/commands/*.test.mts ../../tests/evry/adapters/people-organization/reads/*.test.mts ../../tests/evry/catalog/result-cards.test.mts ../../tests/evry/evals/golden.test.mts ../../tests/evry/evals/households.test.mts ../../tests/evry/evals/followups.test.mts"
	},
	"dependencies": {
		"@ai-sdk/openai": "4.0.99",
		"@ai-sdk/provider": "4.0.31",
		"@everyfield/contracts": "workspace:*",
		"@everyfield/db": "workspace:*",
		"@everyfield/domain": "workspace:*",
		"@langfuse/otel": "6.0.1",
		"@langfuse/tracing": "6.0.1",
		"@langfuse/vercel-ai-sdk": "6.0.1",
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/context-async-hooks": "2.12.0",
		"@opentelemetry/core": "2.12.0",
		"@opentelemetry/exporter-trace-otlp-http": "0.223.0",
		"@opentelemetry/otlp-exporter-base": "0.223.0",
		"@opentelemetry/sdk-trace": "2.12.0",
		"@opentelemetry/sdk-trace-base": "2.12.0",
		"ai": "7.0.148",
		"server-only": "0.0.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"typescript": "6.0.3",
		"oxlint": "1.92.0"
	}
}
