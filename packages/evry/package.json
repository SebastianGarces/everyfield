{
	"name": "@everyfield/evry",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./tracing": "./src/runtime/trace.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "eslint --max-warnings=0 .",
		"test:unit": "node --conditions=react-server --test ../../tests/evry/catalog/*.test.mts ../../tests/evry/evals/*.test.mts",
		"test:db": "node --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test --test-concurrency=1 ../../tests/evry/runtime/*.test.mts ../../tests/evry/execution/*.test.mts ../../tests/evry/adapters/people/reads/*.test.mts ../../tests/evry/adapters/people/commands/*.test.mts ../../tests/evry/adapters/people-organization/reads/*.test.mts"
	},
	"dependencies": {
		"@ai-sdk/openai": "4.0.99",
		"@ai-sdk/provider": "4.0.31",
		"@everyfield/contracts": "workspace:*",
		"@everyfield/db": "workspace:*",
		"@everyfield/domain": "workspace:*",
		"@langfuse/otel": "6.0.1",
		"@langfuse/tracing": "6.0.1",
		"@langfuse/vercel-ai-sdk": "6.0.1",
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/context-async-hooks": "2.12.0",
		"@opentelemetry/core": "2.12.0",
		"@opentelemetry/exporter-trace-otlp-http": "0.223.0",
		"@opentelemetry/otlp-exporter-base": "0.223.0",
		"@opentelemetry/sdk-trace": "2.12.0",
		"@opentelemetry/sdk-trace-base": "2.12.0",
		"ai": "7.0.148",
		"server-only": "0.0.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/node": "^24",
		"eslint": "^9.39.0",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.57.0"
	}
}
