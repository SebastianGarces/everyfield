{
	"name": "@everyfield/domain",
	"private": true,
	"type": "module",
	"exports": {
		"./early-access": "./src/early-access/index.ts",
		"./early-access/contract": "./src/early-access/contract.ts",
		"./operations": "./src/operations/index.ts",
		"./identity": "./src/identity/index.ts",
		"./organizations": "./src/organizations/index.ts",
		"./access": "./src/access/index.ts",
		"./people": "./src/people/index.ts",
		"./onboarding": "./src/onboarding/index.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "eslint --max-warnings=0 .",
		"test": "tsx --env-file-if-exists=../../apps/web/.env.local --test --test-concurrency=1 test/*.test.ts",
		"test:unit": "python3 src/access/generate.py --check && node --test ../../tests/integration/operations/unit.test.mts && node --conditions=react-server --test ../../tests/integration/access/unit.test.mts",
		"test:operations": "node --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test ../../tests/integration/operations/*.test.mts",
		"test:identity": "tsx --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test ../../tests/integration/identity/*.test.mts",
		"test:identity:production": "tsx --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test ../../tests/integration/identity/timing.production.mts",
		"test:organizations": "node --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test --test-concurrency=1 ../../tests/integration/organizations/*.test.mts",
		"test:access": "node --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test --test-concurrency=1 ../../tests/integration/access/*.test.mts",
		"test:people": "node --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test ../../tests/integration/people/*.test.mts",
		"test:db": "pnpm test && pnpm test:people && pnpm test:onboarding",
		"test:onboarding": "node --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test --test-concurrency=1 ../../tests/integration/onboarding/*.test.mts"
	},
	"dependencies": {
		"@everyfield/db": "workspace:*",
		"zod": "4.6.7",
		"@everyfield/contracts": "workspace:*",
		"better-auth": "1.7.10",
		"server-only": "0.0.1"
	},
	"devDependencies": {
		"@types/node": "^24",
		"typescript": "6.0.3",
		"eslint": "^9.39.0",
		"typescript-eslint": "^8.57.0",
		"tsx": "^4.21.0"
	}
}
