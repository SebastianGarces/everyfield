{
	"name": "@everyfield/domain",
	"private": true,
	"type": "module",
	"exports": {
		"./early-access": "./src/early-access/index.ts",
		"./early-access/contract": "./src/early-access/contract.ts",
		"./operations": "./src/operations/index.ts",
		"./identity": "./src/identity/index.ts",
		"./organizations": "./src/organizations/index.ts",
		"./access": "./src/access/index.ts",
		"./people": "./src/people/index.ts",
		"./onboarding": "./src/onboarding/index.ts",
		"./settings": "./src/settings/index.ts",
		"./meetings": "./src/meetings/index.ts",
		"./teams": "./src/teams/index.ts",
		"./tasks": "./src/tasks/index.ts",
		"./followups": "./src/followups/index.ts",
		"./notifications": "./src/notifications/index.ts",
		"./communication": "./src/communication/index.ts",
		"./wiki": "./src/wiki/index.ts",
		"./documents": "./src/documents/index.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "eslint --max-warnings=0 .",
		"test": "tsx --env-file-if-exists=../../apps/web/.env.local --test --test-concurrency=1 test/*.test.ts",
		"test:unit": "node --conditions=react-server --test ../../tests/integration/access/unit.test.mts",
		"test:operations": "node --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test ../../tests/integration/operations/*.test.mts",
		"test:identity": "tsx --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test ../../tests/integration/identity/*.test.mts",
		"test:identity:production": "tsx --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test ../../tests/integration/identity/timing.production.mts",
		"test:organizations": "node --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test --test-concurrency=1 ../../tests/integration/organizations/*.test.mts",
		"test:access": "node --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test --test-concurrency=1 ../../tests/integration/access/*.test.mts",
		"test:people": "node --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test ../../tests/integration/people/*.test.mts ../../tests/integration/people/fields/*.test.mts ../../tests/integration/people/assessments/*.test.mts ../../tests/integration/people/csv/*.test.mts ../../tests/integration/people/corrections/*.test.mts",
		"test:meetings": "tsx --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test --test-concurrency=1 ../../tests/integration/meetings/*.test.mts",
		"test:db": "pnpm test:writes",
		"test:onboarding": "tsx --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test --test-concurrency=1 ../../tests/integration/onboarding/*.test.mts",
		"test:invitations": "tsx --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test ../../tests/integration/identity/invitations.test.mts ../../tests/integration/identity/locks.test.mts",
		"test:settings": "tsx --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test --test-concurrency=1 ../../tests/integration/settings/*.test.mts",
		"test:tasks": "tsx --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test --test-concurrency=1 ../../tests/integration/tasks/*.test.mts",
		"test:communication": "tsx --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test --test-concurrency=1 ../../tests/integration/communication/*.test.mts",
		"test:followups": "tsx --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test --test-concurrency=1 ../../tests/integration/followups/*.test.mts",
		"test:writes": "tsx --conditions=react-server --env-file-if-exists=../../apps/web/.env.local --test ../../tests/integration/writes/statements.test.mts",
		"migrate": "tsx --conditions=react-server --env-file-if-exists=../../apps/web/.env.local scripts/migrate.ts"
	},
	"dependencies": {
		"@everyfield/db": "workspace:*",
		"zod": "4.6.7",
		"@everyfield/contracts": "workspace:*",
		"@everyfield/reference": "workspace:*",
		"better-auth": "1.7.10",
		"server-only": "0.0.1"
	},
	"devDependencies": {
		"@types/node": "^24",
		"typescript": "6.0.3",
		"eslint": "^9.39.0",
		"typescript-eslint": "^8.57.0",
		"tsx": "^4.21.0"
	}
}
