{
	"format": "everyfield.doc/1",
	"kind": "template",
	"id": "conflict-of-interest-policy",
	"version": 1,
	"title": "Conflict of Interest Policy",
	"description": "How the board handles a personal interest in a decision.",
	"class": "formal/legal",
	"exports": ["pdf", "docx"],
	"fields": [
		{
			"key": "church_name",
			"label": "Church name",
			"type": "text",
			"source": "church.name",
			"required": true,
			"sample": "Harbor City Church"
		},
		{
			"key": "church_legal_name",
			"label": "Legal name",
			"type": "text",
			"source": "brand.legalName",
			"fallback": "{church_name}",
			"sample": "Harbor City Church, Inc."
		}
	],
	"page": {
		"size": "letter",
		"orientation": "portrait",
		"margin": {
			"top": 40,
			"right": 40,
			"bottom": 56,
			"left": 40
		},
		"tile": null,
		"header": null,
		"footer": {
			"pages": "all",
			"content": [
				{
					"type": "columns",
					"content": [
						{
							"type": "column",
							"attrs": {
								"width": 3
							},
							"content": [
								{
									"type": "paragraph",
									"attrs": {
										"style": "small"
									},
									"content": [
										{
											"type": "field",
											"attrs": {
												"key": "church_legal_name"
											}
										},
										{
											"type": "text",
											"text": "  |  Conflict of Interest Policy"
										}
									]
								}
							]
						},
						{
							"type": "column",
							"attrs": {
								"width": 1,
								"align": "right"
							},
							"content": [
								{
									"type": "paragraph",
									"attrs": {
										"style": "small",
										"align": "right"
									},
									"content": [
										{
											"type": "pageNumber",
											"attrs": {
												"format": "page-of-total"
											}
										}
									]
								}
							]
						}
					]
				}
			]
		}
	},
	"body": {
		"type": "doc",
		"content": [
			{
				"type": "columns",
				"attrs": {
					"valign": "center"
				},
				"content": [
					{
						"type": "column",
						"attrs": {
							"width": 1
						},
						"content": [
							{
								"type": "image",
								"attrs": {
									"source": "logo",
									"width": 150,
									"height": 34,
									"align": "left",
									"alt": "Church logo"
								}
							}
						]
					},
					{
						"type": "column",
						"attrs": {
							"width": 1,
							"align": "right"
						},
						"content": [
							{
								"type": "paragraph",
								"attrs": {
									"style": "kicker",
									"align": "right"
								},
								"content": [
									{
										"type": "text",
										"text": "Board policy"
									}
								]
							}
						]
					}
				]
			},
			{
				"type": "divider",
				"attrs": {
					"weight": "rule",
					"color": "primary"
				}
			},
			{
				"type": "heading",
				"attrs": {
					"level": 1
				},
				"content": [
					{
						"type": "text",
						"text": "Conflict of Interest Policy"
					}
				]
			},
			{
				"type": "paragraph",
				"attrs": {
					"style": "lead"
				},
				"content": [
					{
						"type": "text",
						"text": "This policy says how the board of "
					},
					{
						"type": "field",
						"attrs": {
							"key": "church_name"
						}
					},
					{
						"type": "text",
						"text": ", a church plant, deals with a personal interest in a decision. Read it with your board and a lawyer in your state. Then change the words to fit your church plant."
					}
				]
			},
			{
				"type": "heading",
				"attrs": {
					"level": 2,
					"numbered": true
				},
				"content": [
					{
						"type": "text",
						"text": "Purpose"
					}
				]
			},
			{
				"type": "paragraph",
				"content": [
					{
						"type": "text",
						"text": "The board makes decisions for the whole church plant. This policy keeps those decisions free of private gain. It also protects each board member from the doubt that an undisclosed interest can cause."
					}
				]
			},
			{
				"type": "heading",
				"attrs": {
					"level": 2,
					"numbered": true
				},
				"content": [
					{
						"type": "text",
						"text": "Who this policy covers"
					}
				]
			},
			{
				"type": "paragraph",
				"content": [
					{
						"type": "text",
						"text": "This policy covers each board member of "
					},
					{
						"type": "field",
						"attrs": {
							"key": "church_name"
						}
					},
					{
						"type": "text",
						"text": ". The board may also apply it to the pastor, to staff and to any person who can spend the money of the church plant."
					}
				]
			},
			{
				"type": "heading",
				"attrs": {
					"level": 2,
					"numbered": true
				},
				"content": [
					{
						"type": "text",
						"text": "What counts as an interest"
					}
				]
			},
			{
				"type": "paragraph",
				"content": [
					{
						"type": "text",
						"text": "A board member has an interest when a decision could help the member, the member's family or a business that the member owns or leads. The help may be money or it may be something else."
					}
				]
			},
			{
				"type": "bulletList",
				"content": [
					{
						"type": "listItem",
						"content": [
							{
								"type": "paragraph",
								"content": [
									{
										"type": "text",
										"text": "A financial interest. Examples: a contract, a sale, a rental, a salary or a gift."
									}
								]
							}
						]
					},
					{
						"type": "listItem",
						"content": [
							{
								"type": "paragraph",
								"content": [
									{
										"type": "text",
										"text": "A personal interest. Examples: a job for a relative, a friendship that could sway the vote or a duty to another organization."
									}
								]
							}
						]
					}
				]
			},
			{
				"type": "heading",
				"attrs": {
					"level": 2,
					"numbered": true
				},
				"content": [
					{
						"type": "text",
						"text": "The duty to disclose"
					}
				]
			},
			{
				"type": "paragraph",
				"content": [
					{
						"type": "text",
						"text": "A board member who has a personal interest in a decision tells the board and does not vote on it. The member tells the board as soon as the member knows of the interest. The member tells the chair or the secretary in writing, or says it at the meeting."
					}
				]
			},
			{
				"type": "heading",
				"attrs": {
					"level": 2,
					"numbered": true
				},
				"content": [
					{
						"type": "text",
						"text": "How the board decides"
					}
				]
			},
			{
				"type": "paragraph",
				"content": [
					{
						"type": "text",
						"text": "The member explains the interest and answers questions. Then the member leaves the room. The other board members decide by a majority vote whether a conflict exists. If they are not sure, they treat the interest as a conflict."
					}
				]
			},
			{
				"type": "heading",
				"attrs": {
					"level": 2,
					"numbered": true
				},
				"content": [
					{
						"type": "text",
						"text": "When a conflict exists"
					}
				]
			},
			{
				"type": "orderedList",
				"content": [
					{
						"type": "listItem",
						"content": [
							{
								"type": "paragraph",
								"content": [
									{
										"type": "text",
										"text": "The conflicted member stays out of the discussion and does not vote."
									}
								]
							}
						]
					},
					{
						"type": "listItem",
						"content": [
							{
								"type": "paragraph",
								"content": [
									{
										"type": "text",
										"text": "The conflicted member does not try to sway the other members."
									}
								]
							}
						]
					},
					{
						"type": "listItem",
						"content": [
							{
								"type": "paragraph",
								"content": [
									{
										"type": "text",
										"text": "The other board members compare the choice with at least one other choice, when they can."
									}
								]
							}
						]
					},
					{
						"type": "listItem",
						"content": [
							{
								"type": "paragraph",
								"content": [
									{
										"type": "text",
										"text": "The board approves the choice only if it is fair to "
									},
									{
										"type": "field",
										"attrs": {
											"key": "church_name"
										}
									},
									{
										"type": "text",
										"text": ". At least [number] disinterested board members must vote for it."
									}
								]
							}
						]
					}
				]
			},
			{
				"type": "heading",
				"attrs": {
					"level": 2,
					"numbered": true
				},
				"content": [
					{
						"type": "text",
						"text": "Record in the minutes"
					}
				]
			},
			{
				"type": "paragraph",
				"content": [
					{
						"type": "text",
						"text": "The secretary writes each disclosure and each decision in the minutes of the meeting. The minutes name the member, state the interest and say who voted. They also say that the member left the room."
					}
				]
			},
			{
				"type": "heading",
				"attrs": {
					"level": 2,
					"numbered": true
				},
				"content": [
					{
						"type": "text",
						"text": "Yearly statement"
					}
				]
			},
			{
				"type": "paragraph",
				"content": [
					{
						"type": "text",
						"text": "Each board member signs a written statement once each year, by [date]. The statement says that the member has read this policy and lists every interest that the policy covers. A new board member signs one before the first vote. The secretary keeps the statements with the records of the church plant."
					}
				]
			},
			{
				"type": "heading",
				"attrs": {
					"level": 2,
					"numbered": true
				},
				"content": [
					{
						"type": "text",
						"text": "If a member breaks this policy"
					}
				]
			},
			{
				"type": "paragraph",
				"content": [
					{
						"type": "text",
						"text": "The board hears the facts and listens to the member. If the board finds that the member broke this policy, it decides what to do. It may reverse the decision, ask the member to step down or remove the member as the bylaws allow."
					}
				]
			},
			{
				"type": "paragraph",
				"content": [
					{
						"type": "text",
						"text": "The board of "
					},
					{
						"type": "field",
						"attrs": {
							"key": "church_name"
						}
					},
					{
						"type": "text",
						"text": " adopted this policy. Each board member signs and dates below."
					}
				]
			},
			{
				"type": "table",
				"attrs": {
					"style": "grid",
					"header": true,
					"headerFill": "muted",
					"zebra": false,
					"writeInRows": 3,
					"rowHeight": 30,
					"columns": [
						{
							"id": "member",
							"label": "Board member",
							"type": "text",
							"width": 150
						},
						{
							"id": "role",
							"label": "Role",
							"type": "text",
							"width": 110
						},
						{
							"id": "signature",
							"label": "Signature",
							"type": "text",
							"width": 150
						},
						{
							"id": "date",
							"label": "Date",
							"type": "text",
							"width": 0
						}
					]
				},
				"content": []
			}
		]
	}
}
