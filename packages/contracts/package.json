{
	"name": "@everyfield/contracts",
	"private": true,
	"type": "module",
	"exports": {
		"./common": "./src/common/index.ts",
		"./reference": "./src/reference/index.ts",
		"./identity": "./src/identity/index.ts",
		"./access": "./src/access/index.ts",
		"./people": "./src/people/index.ts",
		"./organizations": "./src/organizations/index.ts",
		"./onboarding": "./src/onboarding/index.ts",
		"./onboarding/server": "./src/onboarding/server.ts",
		"./settings": "./src/settings/index.ts",
		"./settings/native": "./src/settings/native.ts",
		"./settings/server": "./src/settings/server.ts",
		"./meetings": "./src/meetings/index.ts",
		"./teams": "./src/teams/index.ts",
		"./documents": "./src/documents/index.ts",
		"./branding": "./src/branding/index.ts",
		"./teams/responsibilities": "./src/teams/responsibilities/index.ts",
		"./tasks": "./src/tasks/index.ts",
		"./followups": "./src/followups/index.ts",
		"./notifications": "./src/notifications/index.ts",
