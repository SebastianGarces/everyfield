{
	"$schema": "../../feature-map.schema.json",
	"feature": "app",
	"catalog": ["ADM-006", "ADM-007"],
	"surfaces": [
		{
			"id": "app.cron-jobs",
			"says": "The scheduler endpoint the platform cron calls: with the exact bearer it runs every feature's due jobs and mail passes in one tick; a call without that bearer gets 401 and runs nothing, and a deployment with no cron secret set answers 503.",
			"routes": [],
			"endpoints": ["/api/cron/jobs"],
			"reach": [
				{
					"link": "/api/cron/jobs"
				}
			],
			"personas": {
				"visitor": "none"
			},
			"states": [
				{
					"id": "refused",
					"reach": {
						"persona": "visitor",
						"open": "/api/cron/jobs",
						"seed": "qa"
					},
					"expect": [
						{
							"text": "unauthorized",
							"match": "contains"
						}
					]
				}
			],
			"behaviors": []
		},
		{
