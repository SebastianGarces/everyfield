		{
			"id": "people.list",
			"says": "The church's directory as a list, cards or the recruitment pipeline, with search and filters in the address.",
			"routes": ["/people"],
			"endpoints": ["/api/people/export"],
			"catalog": ["PPL-001", "PPL-002", "PPL-007", "PPL-019"],
			"reach": [
				{
					"rail": "People",
					"personas": ["owner", "admin", "member"]
				}
			],
			"personas": {
				"owner": "write",
				"admin": "write",
				"member": "read",
				"visitor": "none"
			},
			"states": [
				{
					"id": "populated",
					"reach": {
						"persona": "owner",
						"open": "/people",
						"seed": "qa"
					},
					"expect": [
						{
							"role": "radiogroup",
							"name": "View"
						},
						{
							"role": "button",
							"name": "Add person"
						}
					]
				},
				{
					"id": "member",
					"reach": {
						"persona": "member",
						"open": "/people",
						"seed": "qa"
					},
					"expect": [
						{
							"role": "radiogroup",
							"name": "View"
						},
						{
							"noText": "Import CSV"
						}
					]
				},
				{
					"id": "loading",
					"file": "apps/web/src/app/(product)/(frame)/people/(list)/loading.tsx",
					"reach": {
						"manual": "shows only while the server renders the list"
					},
					"expect": [
						{
							"text": "Loading people"
						}
					]
				},
				{
					"id": "error",
					"file": "apps/web/src/app/(product)/(frame)/people/error.tsx",
					"reach": {
						"manual": "renders only when the page throws while rendering"
					},
					"expect": [
						{
							"role": "heading",
							"name": "We could not load your people"
						}
					]
				}
			],
			"behaviors": [
				{
					"id": "search",
					"says": "Typing in Search people narrows the directory after a pause and keeps the term in the address.",
					"catalog": ["PPL-001"],
					"operations": ["people.listPeople"],
					"proof": {
						"tests": [
							{
								"file": "tests/integration/people/people.test.mts",
								"name": "AC:TARGET-PPL-001 literal search, tag intersection, full totals and page numbers past ties"
							},
							{
								"file": "tests/unit/people/model.test.mjs",
								"name": "AC:TARGET-PPL-001 INV-url: the page number lives in the address; a filter change goes back to page one"
							}
						],
						"cases": ["TARGET-PPL-001"],
						"browser": {
							"state": "populated",
							"steps": [
								{
									"type": "Maria",
									"into": "Search people"
								}
							],
							"expect": [
								{
									"url": "/people?q=Maria"
								},
								{
									"role": "link",
									"name": "Maria Santos"
								},
								{
									"absent": {
										"role": "link",
										"name": "James Okafor"
									}
								}
							],
							"kind": "behavior"
						}
					}
				},
				{
					"id": "add-person",
					"says": "An Owner or Admin adds a person with only a name and lands on their page.",
					"catalog": ["PPL-002"],
					"operations": ["people.createPerson"],
					"proof": {
						"tests": [
							{
								"file": "tests/integration/people/people.test.mts",
								"name": "AC:TARGET-PPL-002 AC:LAUNCH46-003 AC:SEC-02 AC:TEN-002 minimal contact, explicit null, current tenancy and atomic retry"
							}
						],
						"cases": ["TARGET-PPL-002"],
						"browser": {
							"state": "populated",
							"steps": [
								{
									"click": {
										"role": "button",
										"name": "Add person"
									}
								},
								{
									"type": "Map Proof Person",
									"into": "Name"
								},
								{
									"press": "Enter"
								}
							],
							"expect": [
								{
									"url": "/people/{personId}"
								},
								{
									"role": "heading",
									"name": "Map Proof Person"
								}
							],
							"kind": "behavior"
						}
					}
				},
				{
					"id": "pipeline",
					"says": "The Pipeline view shows one column per stage; the tests prove a move keeps its place and newest revision.",
					"catalog": ["PPL-007"],
					"operations": ["people.getPipelineData", "people.reorderPipeline"],
					"proof": {
						"tests": [
							{
								"file": "tests/integration/people/people.test.mts",
								"name": "AC:TARGET-PPL-007 INV-move-round-trips: a pipeline move is one transaction with a constant round-trip count"
							},
							{
								"file": "tests/unit/people/model.test.mjs",
								"name": "AC:TARGET-PPL-007 INV-move-revisions: after reorder, away and back, a card keeps its newest revision and the saved order"
							}
						],
						"cases": ["TARGET-PPL-007"],
						"browser": {
							"state": "populated",
							"steps": [
								{
									"click": {
										"role": "radio",
										"name": "Pipeline"
									}
								}
							],
							"expect": [
								{
									"url": "/people?view=pipeline"
								},
								{
									"role": "region",
									"name": "Prospect",
									"match": "contains"
								},
								{
									"role": "region",
									"name": "Core group",
									"match": "contains"
								}
							],
							"kind": "behavior"
						}
					}
				},
				{
					"id": "export",
					"says": "Export CSV downloads the directory as it is filtered, without private fields.",
					"catalog": ["PPL-019"],
					"operations": ["people.exportPeople"],
					"proof": {
						"tests": [
							{
								"file": "tests/integration/people/csv/csv.test.mts",
								"name": "AC:TARGET-PPL-019 AC:PERSONREF-HOUSEHOLD-TAG-SKILL-NOTE-RETIRE INV-tenancy INV-filters the export matches the directory's filters as formula-safe CSV without private fields"
							}
						],
						"cases": ["TARGET-PPL-019"],
						"browser": {
							"state": "populated",
							"steps": [
								{
									"click": {
										"role": "button",
										"name": "Export CSV"
									}
								}
							],
							"expect": [
								{
									"role": "heading",
									"name": "Export people"
								}
							],
							"kind": "presence"
						}
					}
				}
			]
		},
