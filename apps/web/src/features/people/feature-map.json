{
	"$schema": "../../../feature-map.schema.json",
	"feature": "people",
	"catalog": [
		"PPL-001",
		"PPL-002",
		"PPL-003",
		"PPL-005",
		"PPL-006",
		"PPL-007",
		"PPL-008",
