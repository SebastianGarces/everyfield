		{
			"id": "organizations.pipeline",
			"says": "A sending church's or network's pipeline board: one column per stage, search and the six-month filter in the address, goals, Add person and Export.",
			"routes": ["/organization/pipeline"],
			"endpoints": ["/organization/pipeline/export"],
			"catalog": ["MUL-001", "MUL-005", "MUL-007", "MUL-008"],
			"reach": [
				{
					"rail": "Pipeline",
					"personas": ["network", "graceOwner", "hillOwner"]
				}
			],
			"personas": {
				"graceOwner": "write",
				"network": "write",
				"hillOwner": "write",
				"resident": "none",
				"owner": "none",
				"visitor": "none"
			},
			"states": [
				{
					"id": "board",
					"reach": {
						"persona": "graceOwner",
						"open": "/organization/pipeline",
						"seed": "qa"
					},
					"expect": [
						{
							"role": "heading",
							"name": "Pipeline"
						},
						{
							"role": "link",
							"name": "Casey Lee"
						},
						{
							"role": "link",
							"name": "Jordan Reyes"
						},
						{
							"role": "region",
							"name": "Sending goals and leadership conversations"
						}
					]
				},
				{
					"id": "empty",
					"reach": {
						"persona": "network",
						"open": "/organization/pipeline",
						"seed": "qa"
					},
					"expect": [
						{
							"role": "heading",
							"name": "No one in your pipeline yet"
						},
						{
							"role": "region",
							"name": "Potential leader"
						}
					]
				},
				{
					"id": "not-available",
					"reach": {
						"persona": "resident",
						"open": "/organization/pipeline",
						"seed": "qa"
					},
					"expect": [
						{
							"role": "heading",
							"name": "This page is not available"
						}
					]
				}
			],
			"behaviors": [
				{
					"id": "add-person",
					"says": "An Owner or Admin adds a person with only a name; they join the first stage and stay after a reload.",
					"catalog": ["MUL-001"],
					"operations": ["orgPeople.create"],
					"proof": {
						"tests": [
							{
								"file": "tests/integration/organizations/pipeline.test.mts",
								"name": "AC:ADR1-001 AC:ADR1-002 an Owner adds a person with an email and responsible staff; nobody outside the organization sees them"
							}
						],
						"cases": ["ADR1-001", "ADR1-002"],
						"browser": {
							"state": "board",
							"steps": [
								{
									"click": {
										"role": "button",
										"name": "Add person"
									}
								},
								{
									"type": "Map Pipeline Person",
									"into": "Name"
								},
								{
									"press": "Enter"
								},
								{
									"open": "/organization/pipeline"
								}
							],
							"expect": [
								{
									"role": "link",
									"name": "Map Pipeline Person"
								}
							],
							"kind": "behavior"
						}
					}
				},
				{
					"id": "search",
					"says": "Search the pipeline, then Enter, narrows the board to matching people and keeps the term in the address.",
					"catalog": ["MUL-008"],
					"operations": ["pipeline.listPeople"],
					"proof": {
						"tests": [
							{
								"file": "tests/unit/organizations/pipeline-model.test.mts",
								"name": "the board's filters round-trip through the address, and anything unreadable falls back"
							},
							{
								"file": "tests/integration/organizations/pipeline.test.mts",
								"name": "AC:ADR1-002 AC:ADR1-009 responsible staff see their own people and notes, and nothing of anyone else's"
							}
						],
						"cases": ["ADR1-009"],
						"browser": {
							"state": "board",
							"steps": [
								{
									"type": "Casey",
									"into": "Search the pipeline"
								},
								{
									"press": "Enter"
								}
							],
							"expect": [
								{
									"url": "/organization/pipeline?q=Casey"
								},
								{
									"role": "link",
									"name": "Casey Lee"
								},
								{
									"absent": {
										"role": "link",
										"name": "Jordan Reyes"
									}
								}
							],
							"kind": "behavior"
						}
					}
				},
				{
					"id": "goals",
					"says": "Add goal opens the sending goal form; the tests prove a saved goal reads back and moves nobody.",
					"catalog": ["MUL-007"],
					"operations": ["pipeline.saveGoal"],
					"proof": {
						"tests": [
							{
								"file": "tests/integration/organizations/goals.test.mts",
								"name": "AC:ADR1-007 an Owner adds and edits goals; a negative target is refused; saving a goal moves nobody"
							}
						],
						"cases": ["ADR1-007"],
						"browser": {
							"state": "board",
							"steps": [
								{
									"click": {
										"role": "button",
										"name": "Add goal"
									}
								}
							],
							"expect": [
								{
									"role": "heading",
									"name": "Add a sending goal"
								}
							],
							"kind": "presence"
						}
					}
				},
				{
					"id": "export",
					"says": "Export opens the pipeline export; the tests prove the file holds contact, stage history and programs and says what and when.",
					"catalog": ["MUL-005"],
					"operations": [],
					"noOperation": "the export is loadPipelineExport; the catalog's orgPeople.export is marked not built",
					"proof": {
						"tests": [
							{
								"file": "tests/integration/organizations/data.test.mts",
								"name": "AC:ADR1-005 INV-privacy: the export holds contact, stage history, programs, enrollments and completions, and says what and when"
							}
						],
						"cases": ["ADR1-005"],
						"browser": {
							"state": "board",
							"steps": [
								{
									"click": {
										"role": "button",
										"name": "Export"
									}
								}
							],
							"expect": [
								{
									"role": "heading",
									"name": "Export pipeline"
								},
								{
									"role": "button",
									"name": "Download CSV"
								}
							],
							"kind": "presence"
						}
					}
				}
			]
