				"owner": "write",
				"admin": "write",
				"member": "read",
				"visitor": "none"
			},
			"states": [
				{
					"id": "populated",
					"reach": {
						"persona": "owner",
						"open": "/meetings",
						"seed": "qa"
					},
					"expect": [
						{
							"role": "heading",
							"name": "All meetings"
						},
						{
							"role": "button",
							"name": "Plan a meeting"
						}
					]
				},
				{
					"id": "member",
					"reach": {
						"persona": "member",
						"open": "/meetings",
						"seed": "qa"
