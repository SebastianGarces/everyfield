					"proof": {
						"tests": [
							{
								"file": "tests/integration/oversight/health.test.mts",
								"name": "the home shows Limited visibility, Launch readiness and no concern, never On track from silence"
							},
							{
								"file": "tests/integration/oversight/health.test.mts",
								"name": "the plant view shows Launch status and readiness, then the recorded outcome"
							}
						]
					}
				}
			]
		},
