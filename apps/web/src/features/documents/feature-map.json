{
	"$schema": "../../../feature-map.schema.json",
	"feature": "documents",
	"catalog": ["DOC-001", "DOC-002", "DOC-003", "DOC-016", "DOC-022", "DOC-023"],
	"surfaces": [
		{
			"id": "documents.library",
			"says": "Documents: fill a template and download or save it, and open what was written for the church or for you.",
			"routes": ["/documents"],
			"endpoints": ["/documents/preview"],
			"catalog": ["DOC-001", "DOC-002", "DOC-003", "DOC-016"],
			"polls": "the template list keeps fetching PDF page previews, so the page never goes network-idle",
			"reach": [
				{
					"rail": "Documents",
					"personas": ["owner", "admin", "member", "resident", "signup", "triage"]
				}
			],
			"personas": {
				"owner": "write",
				"admin": "write",
				"member": "write",
				"resident": "write",
				"signup": "write",
				"triage": "write",
				"visitor": "none"
			},
			"states": [
				{
					"id": "templates",
					"reach": {
						"persona": "owner",
						"open": "/documents",
						"seed": "qa"
					},
					"expect": [
						{
							"text": "Saved for your church",
							"match": "contains"
						},
						{
							"role": "button",
							"name": "Save for your church"
						},
						{
							"role": "link",
							"name": "QA welcome letter"
						},
						{
							"role": "link",
							"name": "Church documents"
						}
					]
				},
				{
					"id": "account",
					"reach": {
						"persona": "resident",
						"open": "/documents",
						"seed": "qa"
					},
					"expect": [
						{
							"text": "Your documents",
							"match": "contains"
						},
						{
							"role": "link",
							"name": "New document"
						},
						{
							"absent": {
								"role": "button",
								"name": "Save for your church"
							}
						},
						{
							"absent": {
								"role": "link",
								"name": "Church documents"
							}
						}
					]
				},
				{
					"id": "signed-out",
					"reach": {
						"persona": "visitor",
						"open": "/documents",
						"seed": "qa"
					},
					"expect": [
						{
							"url": "/signin?returnTo=%2Fdocuments"
						}
					]
				},
				{
					"id": "loading",
					"file": "apps/web/src/app/(product)/(frame)/documents/loading.tsx",
					"reach": {
						"manual": "shows only while the server renders the page"
					},
					"expect": [
						{
							"text": "Loading documents"
						}
					]
				},
				{
					"id": "error",
					"file": "apps/web/src/app/(product)/(frame)/documents/error.tsx",
					"reach": {
						"manual": "renders only when the page throws while rendering"
					},
					"expect": [
						{
							"role": "heading",
							"name": "We could not load documents"
						},
						{
							"role": "button",
							"name": "Try again"
						}
					]
				}
			],
			"behaviors": [
				{
					"id": "save-for-church",
					"says": "Save for your church keeps the filled template as a saved file in Saved for your church.",
					"catalog": ["DOC-002", "DOC-003"],
					"operations": ["documents.generate"],
					"proof": {
						"tests": [
							{
								"file": "tests/integration/documents/church.test.mts",
								"name": "AC:DOC-003 Save for your church makes one saved file of each text template and no Church Document"
							},
							{
								"file": "tests/integration/documents/owned.test.mts",
								"name": "AC:CASE-DOC-003 AC:CASE-DOC-015 AC:PROVIDER48-002 AC:PROVIDER48-003 AC:TEN-004 saved renders match the preview and keep a private key"
							}
						],
						"cases": ["CASE-DOC-003"],
						"browser": {
							"kind": "behavior",
							"state": "templates",
							"steps": [
								{
									"click": {
										"role": "button",
										"name": "Save for your church"
									}
								}
							],
							"expect": [
								{
									"noText": "Nothing saved for your church yet."
								},
								{
									"text": "for your church.",
									"match": "contains"
								}
							]
						}
					}
				},
				{
					"id": "filter",
					"says": "The Category choice narrows the template list to that kind of template.",
					"catalog": ["DOC-001"],
					"operations": [],
					"proof": {
						"tests": [
							{
								"file": "tests/integration/documents/documents.test.mts",
								"name": "AC:CASE-DOC-001 the library lists 13 templates and 13 formats, and a retired id does not resolve"
							}
						],
						"cases": ["CASE-DOC-001"],
						"browser": {
							"kind": "behavior",
							"state": "templates",
							"steps": [
								{
									"click": {
										"role": "radio",
										"name": "Launch"
									}
								}
							],
							"expect": [
								{
									"noText": "Guest Sign-in Sheet"
								},
								{
									"noText": "Bylaws"
								}
							]
						}
					},
					"noOperation": "the page reads the list once; its catalog name, documents.templates.list, is not quoted or declared in code"
				}
			]
		},
