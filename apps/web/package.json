{
	"name": "@everyfield/web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint --max-warnings=0 . && node scripts/render-share-images.mjs --check && node scripts/render-mesh-images.mjs --check && node scripts/check-color-literals.mjs && node scripts/check-type-scale.mjs && node scripts/check-corners.mjs",
		"typecheck": "tsc --noEmit",
		"share-images": "node scripts/render-share-images.mjs",
		"mesh-images": "node scripts/render-mesh-images.mjs",
		"test:unit": "node --conditions=react-server --test ../../tests/integration/platform/unit.test.mts ../../tests/integration/jobs/calendar.test.mts ../../tests/ui/tasks/model.test.mjs",
		"typecheck:ts7": "tsgo --noEmit",
		"test:jobs": "node --conditions=react-server --env-file-if-exists=.env.local --test ../../tests/integration/jobs/*.test.mts"
	},
	"dependencies": {
		"@everyfield/db": "workspace:*",
		"@everyfield/domain": "workspace:*",
		"@everyfield/ui": "workspace:*",
		"@hugeicons/core-free-icons": "4.3.5",
		"@hugeicons/react": "1.1.10",
		"motion": "14.2.0",
		"next": "16.4.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"server-only": "0.0.1",
		"zod": "4.6.7",
		"@everyfield/contracts": "workspace:*",
		"better-auth": "1.7.10",
		"@aws-sdk/client-s3": "3.1152.0",
		"@aws-sdk/s3-request-presigner": "3.1152.0",
		"fflate": "0.8.3",
		"pdfjs-dist": "6.4.299",
		"@everyfield/evry": "workspace:*"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "4.3.3",
		"@types/node": "^24",
		"@types/react": "19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^9.39.0",
		"eslint-config-next": "16.4.1",
		"playwright": "1.56.1",
		"sharp": "0.35.5",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"@typescript/native-preview": "7.0.0-dev.20260707.2"
	}
}
