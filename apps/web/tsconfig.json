{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"allowJs": false,
		"incremental": true,
		"allowImportingTsExtensions": true,
		"plugins": [{ "name": "next" }],
		"paths": { "@/*": ["./src/*"] }
	},
	"include": [
		"next-env.d.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/app/.well-known/**/*.ts",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"*.ts"
	],
	"exclude": ["node_modules"]
}
