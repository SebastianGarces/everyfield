# Names only. Copy to apps/web/.env.local and fill in. Never commit values.
DATABASE_URL=
RESEND_API_KEY=
EMAIL_FROM=
EARLY_ACCESS_EMAIL_TO=
CRON_SECRET=
# Optional, for approved real-mail checks only. Leave empty in production.
EARLY_ACCESS_EMAIL_SUBJECT_PREFIX=
# Private object storage for avatars, person photos and commitment documents (Tigris, S3 API). Without them, uploads
# are refused. Use everyfield-dev outside production: the server refuses to start with the production bucket.
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
