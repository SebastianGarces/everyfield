{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://everyfield.app/schemas/feature-map.json",
	"title": "Feature map",
	"description": "What one feature directory offers, how each persona reaches it and what proves each behavior works. Checked by tools/ci/feature-maps.ts; personas come from the QA seed (tools/qa/personas.json).",
	"type": "object",
	"additionalProperties": false,
	"required": ["feature", "catalog", "surfaces"],
	"properties": {
		"$schema": {
			"type": "string"
		},
		"feature": {
			"type": "string",
			"pattern": "^[a-z][a-z-]*$"
		},
		"catalog": {
			"$ref": "#/$defs/catalogIds"
		},
		"surfaces": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/surface"
			}
		}
	},
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]*$"
		},
		"catalogIds": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^[A-Z]+-[0-9]+[a-z]?$"
			}
		},
		"route": {
			"type": "string",
			"pattern": "^/[^\\s?#]*$"
		},
		"address": {
			"type": "string",
			"pattern": "^/\\S*$"
		},
		"persona": {
			"type": "string",
			"pattern": "^[a-z][A-Za-z0-9-]*$"
		},
		"text": {
			"type": "string",
			"minLength": 1
		},
		"surface": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "says", "routes", "reach", "personas", "states", "behaviors"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z][a-z-]*\\.[a-z][a-z0-9-]*$"
				},
				"says": {
					"$ref": "#/$defs/text"
				},
				"routes": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/route"
					}
				},
				"endpoints": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/route"
					}
				},
				"catalog": {
					"$ref": "#/$defs/catalogIds"
				},
				"polls": {
					"$ref": "#/$defs/text"
				},
				"reach": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/reach"
					}
				},
				"personas": {
					"type": "object",
					"minProperties": 1,
					"additionalProperties": {
						"enum": ["write", "read", "none"]
					}
				},
				"states": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/state"
					}
				},
				"behaviors": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/behavior"
					}
				}
			}
		},
		"reach": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["rail", "personas"],
					"properties": {
						"rail": {
							"$ref": "#/$defs/text"
						},
						"personas": {
							"type": "array",
							"minItems": 1,
							"items": {
								"$ref": "#/$defs/persona"
							}
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["from", "persona", "path"],
					"properties": {
						"from": {
							"type": "string",
							"pattern": "^[a-z][a-z-]*\\.[a-z][a-z0-9-]*$"
						},
						"persona": {
							"$ref": "#/$defs/persona"
						},
						"path": {
							"type": "array",
							"minItems": 1,
							"items": {
								"$ref": "#/$defs/step"
							}
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["link"],
					"properties": {
						"link": {
							"$ref": "#/$defs/address"
						},
						"fill": {
							"$ref": "#/$defs/fill"
						},
						"email": {
							"$ref": "#/$defs/text"
						}
					}
				}
			]
		},
		"fill": {
			"type": "object",
			"minProperties": 1,
			"additionalProperties": {
				"$ref": "#/$defs/text"
			}
		},
		"state": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "reach", "expect"],
			"properties": {
				"id": {
					"$ref": "#/$defs/id"
				},
				"file": {
					"type": "string",
					"pattern": "^apps/web/src/app/.+\\.tsx$"
				},
				"reach": {
					"$ref": "#/$defs/stateReach"
				},
				"defect": {
					"$ref": "#/$defs/text"
				},
				"expect": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/observable"
					}
				}
			}
		},
		"stateReach": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["persona", "open", "seed"],
					"properties": {
						"persona": {
							"$ref": "#/$defs/persona"
						},
						"open": {
							"$ref": "#/$defs/address"
						},
						"path": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/step"
							}
						},
						"seed": {
							"enum": ["qa"]
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["persona", "setup"],
					"properties": {
						"persona": {
							"$ref": "#/$defs/persona"
						},
						"setup": {
							"type": "array",
							"minItems": 1,
							"items": {
								"$ref": "#/$defs/step"
							}
						},
						"open": {
							"$ref": "#/$defs/address"
						},
						"path": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/step"
							}
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["manual"],
					"properties": {
						"manual": {
							"$ref": "#/$defs/text"
						}
					}
				}
			]
		},
		"behavior": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "says", "catalog", "operations", "proof"],
			"properties": {
				"id": {
					"$ref": "#/$defs/id"
				},
				"says": {
					"$ref": "#/$defs/text"
				},
				"catalog": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string",
						"pattern": "^[A-Z]+-[0-9]+[a-z]?$"
					}
				},
				"operations": {
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^[a-z][A-Za-z]*(\\.[a-z][A-Za-z]*)+$"
					}
				},
				"proof": {
					"type": "object",
					"additionalProperties": false,
					"required": ["tests"],
					"properties": {
						"tests": {
							"type": "array",
							"minItems": 1,
							"items": {
								"$ref": "#/$defs/testRef"
							}
						},
						"cases": {
							"type": "array",
							"items": {
								"type": "string",
								"pattern": "^[A-Z0-9][A-Za-z0-9-]*$"
							}
						},
						"browser": {
							"$ref": "#/$defs/browser"
						}
					}
				},
				"noOperation": {
					"$ref": "#/$defs/text"
				}
			}
		},
		"testRef": {
			"type": "object",
			"additionalProperties": false,
			"required": ["file", "name"],
			"properties": {
				"file": {
					"type": "string",
					"pattern": "^(tests|tools|packages)/.+\\.[cm]?[jt]sx?$"
				},
				"name": {
					"$ref": "#/$defs/text"
				}
			}
		},
		"browser": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "state", "steps", "expect"],
			"properties": {
				"kind": {
					"enum": ["behavior", "presence"]
				},
				"state": {
					"$ref": "#/$defs/id"
				},
				"steps": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/step"
					}
				},
				"expect": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/observable"
					}
				}
			}
		},
		"match": {
			"enum": ["exact", "contains"]
		},
		"step": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["open"],
					"properties": {
						"open": {
							"$ref": "#/$defs/address"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["click"],
					"properties": {
						"click": {
							"$ref": "#/$defs/target"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "into"],
					"properties": {
						"type": {
							"$ref": "#/$defs/text"
						},
						"into": {
							"$ref": "#/$defs/text"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["press"],
					"properties": {
						"press": {
							"$ref": "#/$defs/text"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["upload"],
					"properties": {
						"upload": {
							"type": "string",
							"pattern": "^[a-z][\\w./-]+$"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["expect"],
					"properties": {
						"expect": {
							"$ref": "#/$defs/observable"
						}
					}
				}
			]
		},
		"target": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["role", "name"],
					"properties": {
						"role": {
							"type": "string",
							"pattern": "^[a-z]+$"
						},
						"name": {
							"$ref": "#/$defs/text"
						},
						"match": {
							"$ref": "#/$defs/match"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["text"],
					"properties": {
						"text": {
							"$ref": "#/$defs/text"
						},
						"match": {
							"$ref": "#/$defs/match"
						}
					}
				}
			]
		},
		"observable": {
			"oneOf": [
				{
					"$ref": "#/$defs/target"
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["noText"],
					"properties": {
						"noText": {
							"$ref": "#/$defs/text"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["url"],
					"properties": {
						"url": {
							"type": "string",
							"pattern": "^/"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["absent"],
					"properties": {
						"absent": {
							"type": "object",
							"additionalProperties": false,
							"required": ["role", "name"],
							"properties": {
								"role": {
									"type": "string",
									"pattern": "^[a-z]+$"
								},
								"name": {
									"$ref": "#/$defs/text"
								},
								"match": {
									"$ref": "#/$defs/match"
								}
							}
						}
					}
				}
			]
		},
		"personas": {
			"type": "object",
			"minProperties": 1,
			"propertyNames": {
				"pattern": "^[a-z][A-Za-z0-9-]*$"
			},
			"additionalProperties": {
				"type": "object",
				"additionalProperties": false,
				"required": ["says", "context"],
				"properties": {
					"says": {
						"$ref": "#/$defs/text"
					},
					"context": {
						"enum": ["plant", "organization", "account", "pending", "signed-out"]
					},
					"role": {
						"enum": ["owner", "admin", "member"]
					},
					"residencyLinked": {
						"type": "boolean"
					},
					"seed": {
						"enum": ["qa"]
					}
				}
			}
		},
		"pending": {
			"type": "object",
			"additionalProperties": false,
			"required": ["routes"],
			"properties": {
				"$schema": {
					"type": "string"
				},
				"routes": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/route"
					}
				}
			}
		}
	}
}
