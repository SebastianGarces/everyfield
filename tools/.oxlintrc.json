{
	// tools/, ops/ and scripts/ have no general lint yet (T-176). The root `pnpm lint` (lint:repo) runs only the rules here
	// over them.
	"jsPlugins": ["../scripts/lint/everyfield-plugin.mjs"],
	"categories": {
		"correctness": "off"
	},
	"rules": {
		// AC:WP-029-13: no tool, ops or script file imports resend (any form) or names api.resend.com; mail goes through the
		// guarded senders.
		"everyfield/resend-senders": "error"
	},
	"overrides": [
		{
			"files": ["**/*.test.*", "**/test/**", "**/tests/**"],
			"rules": {
				"everyfield/resend-senders": "off"
			}
		},
		{
			// The lint plugin defines the rule, so it names the Resend host itself.
			"files": ["**/lint/everyfield-plugin.mjs"],
			"rules": {
				"everyfield/resend-senders": "off"
			}
		}
	]
}
