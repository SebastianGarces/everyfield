{
	"compilerOptions": {
		"target": "ES2024",
		"lib": ["ES2024", "ESNext.Collection"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true,
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"typeRoots": ["./packages/db/node_modules/@types"],
		"types": ["node"],
		"noEmit": true
	},
	"include": [
		"scripts/**/*.ts",
		"tools/ci/**/*.ts",
		"tools/qa/**/*.ts",
		"tools/app/**/*.ts",
		"tools/prod-identity/**/*.ts",
		"tools/formal/**/*.ts",
		"ops/actionable-watch/**/*.mts"
	]
}
