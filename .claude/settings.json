{
	"permissions": {
		"allow": [
			"Bash(cd *)",
			"Bash(bin/evf pr open *)",
			"Bash(./bin/evf pr open *)",
			"Bash(*/bin/evf pr open *)",
			"Bash(git add *)",
			"Bash(git commit *)",
			"Bash(git -C * add *)",
			"Bash(git -C * commit *)"
		],
		"ask": ["Bash(git push)", "Bash(git push *)"],
		"deny": [
			"Bash(git push *--force*)",
			"Bash(git push -f*)",
			"Bash(git push * -f*)",
			"Bash(git push * +*)",
			"Bash(git push --mirror*)",
			"Bash(git push * --mirror*)"
		]
	}
}
