{
	"permissions": {
		"allow": [
			"Bash(cd *)",
			"Bash(bin/evf pr open *)",
			"Bash(./bin/evf pr open *)",
			"Bash(*/bin/evf pr open *)",
			"Bash(git add *)",
			"Bash(git commit *)",
			"Bash(git -C * add *)",
			"Bash(git -C * commit *)",
			"Bash(node .agents/skills/verify-preview/scripts/post-review.mjs *)",
			"Bash(node /*/.agents/skills/verify-preview/scripts/post-review.mjs *)"
		],
		"ask": ["Bash(git push)", "Bash(git push *)"],
		"deny": [
			"Bash(git push *--force*)",
			"Bash(git push -f*)",
			"Bash(git push * -f*)",
			"Bash(git push * +*)",
			"Bash(git push --mirror*)",
			"Bash(git push * --mirror*)",
			"Bash(git push * main)",
			"Bash(git push * main *)",
			"Bash(git push *:main*)",
			"Bash(git push *:refs/heads/main*)",
			"Bash(gh pr merge*)",
			"Bash(gh pr review*)",
			"Bash(gh api -X *)",
			"Bash(gh api --method *)",
			"Bash(gh repo *)",
			"Bash(git checkout main*)",
			"Bash(git switch main*)",
			"Bash(git branch -D *)",
			"Bash(git branch -d *)",
			"Bash(git worktree remove*)",
			"Bash(git worktree prune*)",
			"Read(./.env*)",
			"Read(./apps/web/.env*)",
			"Read(./packages/**/.env*)"
		]
	},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/bin/evf hook session-start",
						"timeout": 15
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/bin/evf hook path-guard",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "Read|Grep|Glob",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/bin/evf hook read-guard",
						"timeout": 10
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/bin/evf hook stop",
						"timeout": 15
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/bin/evf hook session-end",
						"timeout": 15
					}
				]
			}
		]
	}
}
