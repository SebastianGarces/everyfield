#!/bin/sh
# evf: Everyfield v3 workflow CLI. Runs tools/evf/main.ts on Node 24+ (native TypeScript).
set -e
here=$(cd "$(dirname "$0")/.." && pwd)
node_bin=node
if ! "$node_bin" -e 'process.exit(+process.versions.node.split(".")[0] >= 24 ? 0 : 1)' 2>/dev/null; then
  node_bin=""
  for candidate in "$HOME"/.nvm/versions/node/v2[4-9]*/bin/node; do
    [ -x "$candidate" ] && node_bin="$candidate"
  done
  if [ -z "$node_bin" ]; then
    echo "evf: Node 24+ is required." >&2
    exit 1
  fi
fi
# One compile cache for every worktree. A caller's value stands, and GitHub runners start empty, so they go without.
if [ -z "${NODE_COMPILE_CACHE+set}" ] && [ "${GITHUB_ACTIONS:-}" != "true" ]; then
  if common=$(git -C "$here" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
    export NODE_COMPILE_CACHE="$common/evf/node-compile-cache"
    # Past 256 MB, drop the oldest entries down to 128 MB. This never fails the command or prints anything.
    if [ -z "${NODE_DISABLE_COMPILE_CACHE:-}" ]; then
      cache_kb=$({ du -sk "$NODE_COMPILE_CACHE" | cut -f1; } 2>/dev/null) || cache_kb=0
      if [ "${cache_kb:-0}" -gt 262144 ] 2>/dev/null; then
        NODE_DISABLE_COMPILE_CACHE=1 "$node_bin" --disable-warning=ExperimentalWarning \
          "$here/tools/evf/compile-cache-prune.ts" "$NODE_COMPILE_CACHE" 131072 >/dev/null 2>&1 || true
      fi
    fi
  fi
fi
exec "$node_bin" --disable-warning=ExperimentalWarning "$here/tools/evf/main.ts" "$@"
