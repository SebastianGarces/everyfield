{
	"plugins": ["typescript", "unicorn"],
	"jsPlugins": ["./scripts/lint/everyfield-plugin.mjs"],
	"categories": {
		"correctness": "off"
	},
	"env": {
		"builtin": true
	},
	"rules": {
		"no-array-constructor": "error",
		"no-unused-expressions": "error",
		"no-unused-vars": [
			"error",
			{
				"vars": "all",
				"args": "after-used",
				"caughtErrors": "all",
				"ignoreRestSiblings": false,
				"argsIgnorePattern": false,
				"varsIgnorePattern": false,
				"caughtErrorsIgnorePattern": false,
				"destructuredArrayIgnorePattern": false
			}
		],
		"typescript/ban-ts-comment": ["error", { "ts-expect-error": true }],
		"typescript/no-duplicate-enum-values": "error",
		"typescript/no-empty-object-type": "error",
		"typescript/no-explicit-any": "error",
		"typescript/no-extra-non-null-assertion": "error",
		"typescript/no-misused-new": "error",
		"typescript/no-namespace": "error",
		"typescript/no-non-null-asserted-optional-chain": "error",
		"typescript/no-require-imports": "error",
		"typescript/no-this-alias": "error",
		"typescript/no-unnecessary-type-constraint": "error",
		"typescript/no-unsafe-declaration-merging": "error",
		"typescript/no-unsafe-function-type": "error",
		"typescript/no-wrapper-object-types": "error",
		"typescript/prefer-as-const": "error",
		"typescript/prefer-namespace-keyword": "error",
		"typescript/triple-slash-reference": "error",
		"everyfield/resend-senders": "error",
		"everyfield/raw-sql-literal": "error",
		"everyfield/request-actor": "error",
		"everyfield/provider-key-mint": "error",
		"everyfield/no-comments": "error",
		"everyfield/shared-outcome": "error",
		"everyfield/server-log": "error",
		"everyfield/no-effects": "error",
		"everyfield/stable-context-value": "error",
		"everyfield/storage-client": "error",
		"everyfield/deployment-env": "error",
		"everyfield/server-config": "error",
		"everyfield/no-silent-catch": "error",
		"everyfield/max-state": "error",
		"everyfield/mint-callers": "error",
		"everyfield/no-sql-comments": "error",
		"everyfield/no-slop-styling": "error"
	},
	"overrides": [
		{
			"files": ["packages/*/src/**"],
			"rules": {
				"everyfield/no-error-message-match": "error"
			}
		},
		{
			"files": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
			"rules": {
				"constructor-super": "off",
				"getter-return": "off",
				"no-class-assign": "off",
				"no-const-assign": "off",
				"no-dupe-class-members": "off",
				"no-dupe-keys": "off",
				"no-func-assign": "off",
				"no-import-assign": "off",
				"no-new-native-nonconstructor": "off",
				"no-obj-calls": "off",
				"no-redeclare": "off",
				"no-setter-return": "off",
				"no-this-before-super": "off",
				"no-unreachable": "off",
				"no-unsafe-negation": "off",
				"no-var": "error",
				"no-with": "off",
				"prefer-const": "error",
				"prefer-rest-params": "error",
				"prefer-spread": "error"
			}
		},
		{
			"files": ["**/*.test.*", "**/test/**", "**/tests/**", "packages/domain/src/early-access/index.ts"],
			"rules": {
				"everyfield/resend-senders": "off"
			}
		},
		{
			"files": ["tests/integration/**", "tests/evry/**", "tests/ui/**", "tests/unit/**", "tests/workflow/**"],
			"rules": {
				"typescript/no-explicit-any": "off",
				"no-unused-vars": [
					"error",
					{
						"vars": "all",
						"args": "after-used",
						"caughtErrors": "all",
						"ignoreRestSiblings": true,
						"argsIgnorePattern": false,
						"varsIgnorePattern": false,
						"caughtErrorsIgnorePattern": false,
						"destructuredArrayIgnorePattern": false
					}
				]
			}
		},
		{
			"files": [
				"tests/workflow/**/*.ts",
				"tests/unit/**/*.mts",
				"tests/ui/**/*.mts",
				"tests/integration/dashboard/**",
				"tests/integration/feedback/**",
				"tests/integration/notifications/**",
				"tests/integration/platform/**",
				"tests/integration/writes/**",
				"tests/integration/branding/**",
				"tests/integration/db/**",
				"tests/integration/flags/**",
				"tests/integration/followups/**",
				"tests/integration/oversight/**",
				"tests/integration/phases/**"
			],
			"rules": {
				"typescript/no-explicit-any": "error"
			}
		},
		{
			"files": ["tests/**/*.cjs"],
			"rules": {
				"typescript/no-require-imports": "off"
			}
		},
		{
			"files": ["packages/*/src/**"],
			"rules": {
				"everyfield/no-timers": "error",
				"everyfield/no-render-writes": "error",
				"everyfield/no-render-get-state": "error",
				"everyfield/feature-boundaries": "error",
				"everyfield/table-writers": "error"
			}
		},
		{
			"files": [
				"packages/contracts/src/**",
				"packages/reference/src/**",
				"packages/ui/src/**",
				"packages/evry/src/**",
				"packages/domain/src/access/**",
				"packages/domain/src/communication/**",
				"packages/domain/src/feedback/**",
				"packages/domain/src/flags/**",
				"packages/domain/src/followups/**",
				"packages/domain/src/identity/**",
				"packages/domain/src/jobs/**",
				"packages/domain/src/launch/**",
				"packages/domain/src/meetings/**",
				"packages/domain/src/operations/**",
				"packages/domain/src/organizations/**",
				"packages/domain/src/oversight/**",
				"packages/domain/src/phases/**",
				"packages/domain/src/settings/**",
				"packages/domain/src/tasks/**",
				"packages/domain/src/teams/**",
				"packages/domain/src/wiki/**"
			],
			"rules": {
				"typescript/no-non-null-assertion": "error"
			}
		},
		{
			"files": ["packages/evry/src/**", "packages/domain/src/**"],
			"rules": {
				"everyfield/private-care-scope": "error"
			}
		},
		{
			"files": ["packages/domain/src/intelligence/**"],
			"rules": {
				"everyfield/private-care-scope": "off"
			}
		},
		{
			"files": ["packages/domain/src/**"],
			"rules": {
				"everyfield/domain-refusals": "error"
			}
		},
		{
			"files": ["packages/domain/src/mail-recipients.ts", "packages/db/src/deployment.ts"],
			"rules": {
				"everyfield/pure-module": "error"
			}
		},
		{
			"files": ["packages/evry/src/runtime/turn.ts"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["../execution", "../execution/*"],
								"message": "The turn wires no executor: a reviewed change runs only when a person approves its review card."
							}
						]
					}
				]
			}
		},
		{
			"files": ["packages/ui/src/**"],
			"plugins": ["react", "jsx-a11y"],
			"rules": {
				"react/jsx-key": "error",
				"react/jsx-no-comment-textnodes": "error",
				"react/jsx-no-duplicate-props": "error",
				"react/no-children-prop": "error",
				"react/no-danger-with-children": "error",
				"react/rules-of-hooks": "error",
				"react/exhaustive-deps": "warn",
				"react/static-components": "error",
				"react/use-memo": "error",
				"react/preserve-manual-memoization": "error",
				"react/incompatible-library": "warn",
				"react/immutability": "error",
				"react/globals": "error",
				"react/refs": "error",
				"react/set-state-in-effect": "error",
				"react/error-boundaries": "error",
				"react/purity": "error",
				"react/set-state-in-render": "error",
				"react/unsupported-syntax": "warn",
				"everyfield/no-inner-html": "error",
				"everyfield/no-cursor-utility": "error",
				"everyfield/no-global-listeners": "error",
				"everyfield/no-raw-history": "error",
				"jsx-a11y/no-static-element-interactions": "error",
				"jsx-a11y/click-events-have-key-events": "error"
			}
		}
	]
}
