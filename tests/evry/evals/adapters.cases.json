				"allowed": ["Casey Brooks", "Casey Morgan", "John Smith", "Jon Smith"]
			},
			"forbid": [
				"/no duplicates (found|in)|(you['’]?re|you are|church is|records are) (all )?clean|no (possible )?duplicates\\b/i",
