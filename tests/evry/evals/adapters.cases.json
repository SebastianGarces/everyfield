			],
			"names": {
				"all": ["Casey Brooks", "Casey Morgan", "John Smith", "Jon Smith"],
				"allowed": ["Casey Brooks", "Casey Morgan", "John Smith", "Jon Smith"]
			},
			"forbid": [
				"/no duplicates (found|in)|(you['’]?re|you are|church is|records are) (all )?clean|no (possible )?duplicates\\b/i",
				"Maria Delgado",
				"Maria Santos",
				"/\\b(yes|definitely|clearly|confirmed)\\b[^.\\n]{0,30}same person/i"
			],
			"derivation": "The earlier import flagged John Smith (with Jon Smith) and Casey Brooks (with Casey Morgan) for review; Maria Delgado with Maria Santos was marked \"Not a duplicate\", so it is not listed. A pair is a possible duplicate, never proof."
		}
