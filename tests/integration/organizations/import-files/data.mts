export function csvOf(rows: string[][]) {
	const cell = (v: string) => (/[",\r\n]/.test(v) ? `"${v.replaceAll('"', '""').replaceAll("\n", "\r\n")}"` : v);
	return "﻿" + rows.map((r) => r.map(cell).join(",") + "\r\n").join("");
}
