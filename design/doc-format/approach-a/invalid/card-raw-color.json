{
	"format": "everyfield.doc/1",
	"kind": "template",
	"id": "commitment-card",
	"version": 1,
	"title": "Core Group Commitment Card",
	"description": "Four commitment cards on one Letter sheet. Cut on the marks.",
	"class": "outward-facing",
	"exports": [
		"pdf",
		"docx"
	],
	"fields": [
		{
			"key": "church_name",
			"label": "Church name",
			"type": "text",
			"source": "church.name",
			"required": true,
			"sample": "Harbor City Church"
		},
		{
			"key": "church_tagline",
			"label": "Tagline",
			"type": "text",
			"source": "brand.tagline",
			"fallback": "A new church plant. You are welcome here.",
			"sample": "A new church plant. You are welcome here."
		},
		{
			"key": "contact_line",
			"label": "Contact line",
			"type": "text",
			"source": "brand.contactLine",
			"fallback": "",
			"sample": "harborcity.church  ·  (555) 010-0199"
		}
	],
	"page": {
		"size": "letter",
		"orientation": "portrait",
		"margin": {
			"top": 0,
			"right": 0,
			"bottom": 0,
			"left": 0
		},
		"tile": {
			"across": 2,
			"down": 2,
			"padding": 14,
			"cutMarks": true
		},
		"header": null,
		"footer": {
			"pages": "all",
			"content": [
				{
					"type": "divider",
					"attrs": {
						"weight": "hairline",
						"color": "primary"
					}
				},
				{
					"type": "paragraph",
					"attrs": {
						"style": "small"
					},
					"content": [
						{
							"type": "field",
							"attrs": {
								"key": "contact_line"
							}
						}
					]
				}
			]
		}
	},
	"body": {
		"type": "doc",
		"content": [
			{
				"type": "box",
				"attrs": {
					"fill": "#1E3A8A",
					"border": "none",
					"padding": 12,
					"keepTogether": true
				},
				"content": [
					{
						"type": "columns",
						"content": [
							{
								"type": "column",
								"attrs": {
									"width": 2
								},
								"content": [
									{
										"type": "image",
										"attrs": {
											"source": "logo",
											"width": 150,
											"height": 44,
											"align": "left",
											"alt": "Church logo"
										}
									},
									{
										"type": "paragraph",
										"attrs": {
											"style": "lead"
										},
										"content": [
											{
												"type": "field",
												"attrs": {
													"key": "church_tagline"
												}
											}
										]
									}
								]
							},
							{
								"type": "column",
								"attrs": {
									"width": 1,
									"align": "right"
								},
								"content": [
									{
										"type": "image",
										"attrs": {
											"source": "photo",
											"width": 72,
											"height": 72,
											"align": "right",
											"alt": ""
										}
									}
								]
							}
						]
					}
				]
			},
			{
				"type": "divider",
				"attrs": {
					"weight": "bar",
					"color": "accent"
				}
			},
			{
				"type": "columns",
				"attrs": {
					"valign": "bottom"
				},
				"content": [
					{
						"type": "column",
						"attrs": {
							"width": 2
						},
						"content": [
							{
								"type": "heading",
								"attrs": {
									"level": 2
								},
								"content": [
									{
										"type": "text",
										"text": "My commitment"
									}
								]
							}
						]
					},
					{
						"type": "column",
						"attrs": {
							"width": 1,
							"align": "right"
						},
						"content": [
							{
								"type": "paragraph",
								"attrs": {
									"style": "kicker",
									"align": "right"
								},
								"content": [
									{
										"type": "text",
										"text": "Core group"
									}
								]
							}
						]
					}
				]
			},
			{
				"type": "paragraph",
				"attrs": {
					"style": "small"
				},
				"content": [
					{
						"type": "text",
						"text": "Through Launch Sunday, I will:"
					}
				]
			},
			{
				"type": "table",
				"attrs": {
					"style": "rows",
					"header": false,
					"headerFill": "none",
					"zebra": false,
					"writeInRows": 0,
					"rowHeight": 0,
					"columns": [
						{
							"id": "done",
							"label": "",
							"type": "check",
							"width": 18,
							"align": "center"
						},
						{
							"id": "commitment",
							"label": "Commitment",
							"type": "text",
							"width": 0
						}
					]
				},
				"content": [
					{
						"type": "row",
						"content": [
							{
								"type": "cell",
								"content": []
							},
							{
								"type": "cell",
								"content": [
									{
										"type": "text",
										"text": "GROW",
										"marks": [
											{
												"type": "tag"
											}
										]
									},
									{
										"type": "text",
										"text": " Join a weekly group and keep learning with the church plant family."
									}
								]
							}
						]
					},
					{
						"type": "row",
						"content": [
							{
								"type": "cell",
								"content": []
							},
							{
								"type": "cell",
								"content": [
									{
										"type": "text",
										"text": "PRAY",
										"marks": [
											{
												"type": "tag"
											}
										]
									},
									{
										"type": "text",
										"text": " Pray each week for our neighbors and for Launch Sunday."
									}
								]
							}
						]
					},
					{
						"type": "row",
						"content": [
							{
								"type": "cell",
								"content": []
							},
							{
								"type": "cell",
								"content": [
									{
										"type": "text",
										"text": "GIVE",
										"marks": [
											{
												"type": "tag"
											}
										]
									},
									{
										"type": "text",
										"text": " Give my time, my gifts and my money toward the launch."
									}
								]
							}
						]
					}
				]
			},
			{
				"type": "columns",
				"attrs": {
					"gap": 8
				},
				"content": [
					{
						"type": "column",
						"attrs": {
							"width": 1
						},
						"content": [
							{
								"type": "writeIn",
								"attrs": {
									"label": "Name",
									"key": "full_name",
									"kind": "text",
									"width": 0
								}
							}
						]
					},
					{
						"type": "column",
						"attrs": {
							"width": 1
						},
						"content": [
							{
								"type": "writeIn",
								"attrs": {
									"label": "Email or phone",
									"key": "contact",
									"kind": "text",
									"width": 0
								}
							}
						]
					}
				]
			},
			{
				"type": "columns",
				"attrs": {
					"gap": 8
				},
				"content": [
					{
						"type": "column",
						"attrs": {
							"width": 2
						},
						"content": [
							{
								"type": "writeIn",
								"attrs": {
									"label": "Signature",
									"key": "signature",
									"kind": "signature",
									"width": 0
								}
							}
						]
					},
					{
						"type": "column",
						"attrs": {
							"width": 1
						},
						"content": [
							{
								"type": "writeIn",
								"attrs": {
									"label": "Date",
									"key": "signed_date",
									"kind": "date",
									"width": 0
								}
							}
						]
					}
				]
			}
		]
	}
}
