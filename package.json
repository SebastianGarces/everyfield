{
	"name": "everyfield",
	"private": true,
	"packageManager": "pnpm@10.34.6",
	"engines": {
		"node": ">=24.22.1"
	},
	"scripts": {
		"dev": "pnpm --filter @everyfield/web dev",
		"build": "pnpm --filter @everyfield/web build",
		"lint": "pnpm -r --if-present lint",
		"typecheck": "pnpm -r --if-present typecheck",
		"check": "pnpm typecheck && pnpm lint && pnpm test:workflow && pnpm test:logs && pnpm build",
		"access:export": "pnpm --filter @everyfield/db export",
		"db:migrate": "pnpm --filter @everyfield/db migrate",
		"test:access": "pnpm --filter @everyfield/domain test",
		"stack:up": "node scripts/stack.mjs up",
		"stack:status": "node scripts/stack.mjs status",
		"stack:down": "node scripts/stack.mjs down",
		"stack:check": "node scripts/stack.mjs check",
		"test:workflow": "node scripts/test-workflow.mjs",
		"test:logs": "node --test tests/workflow/server-logs.test.mjs",
		"test:ui": "node --test 'tests/ui/**/*.test.mjs'",
		"format": "prettier --write \"{apps,packages,tools,scripts,tests}/**/*.{ts,tsx,js,mjs,cjs,css,json}\" \"*.{ts,tsx,js,mjs,cjs,css,json}\" \".prettierrc\"",
		"format:check": "prettier --check \"{apps,packages,tools,scripts,tests}/**/*.{ts,tsx,js,mjs,cjs,css,json}\" \"*.{ts,tsx,js,mjs,cjs,css,json}\" \".prettierrc\""
	},
	"devDependencies": {
		"eslint-config-prettier": "10.1.8",
		"prettier": "3.9.10"
	}
}
