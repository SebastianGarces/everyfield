{
	"name": "everyfield",
	"private": true,
	"packageManager": "pnpm@10.34.6",
	"engines": {
		"node": ">=24.22.1"
	},
	"scripts": {
		"dev": "pnpm --filter @everyfield/web dev",
		"build": "pnpm --filter @everyfield/web build",
		"prepare": "bin/dev hooks install",
		"lint": "pnpm -r --if-present lint && pnpm run lint:repo",
		"lint:repo": "packages/evry/node_modules/.bin/oxlint -c tools/.oxlintrc.json --max-warnings=0 tools && node scripts/lint/check-repo-files.mjs",
		"typecheck": "node tools/ci/typecheck.ts",
		"typecheck:bun": "pnpm -r --if-present typecheck:bun",
		"check": "pnpm typecheck && pnpm lint && pnpm test:workflow && pnpm test:logs && pnpm build",
		"access:export": "pnpm --filter @everyfield/db export",
		"db:migrate": "pnpm --filter @everyfield/domain migrate",
		"test:early-access": "pnpm --filter @everyfield/domain test",
		"stack:up": "node scripts/stack.mjs up",
		"stack:status": "node scripts/stack.mjs status",
		"stack:down": "node scripts/stack.mjs down",
		"stack:check": "node scripts/stack.mjs check",
		"test:workflow": "node scripts/test-workflow.mjs",
		"test:logs": "node --test ${EVF_NODE_TEST_FLAGS:-} tests/workflow/server-logs.test.mjs",
		"test:ui": "node --test 'tests/ui/**/*.test.mjs'",
		"format": "prettier --write \"{apps,packages,tools,scripts,tests}/**/*.{ts,tsx,mts,cts,js,mjs,cjs,css,json}\" \"*.{ts,tsx,js,mjs,cjs,css,json}\" \".prettierrc\"",
		"format:check": "prettier --check \"{apps,packages,tools,scripts,tests}/**/*.{ts,tsx,mts,cts,js,mjs,cjs,css,json}\" \"*.{ts,tsx,js,mjs,cjs,css,json}\" \".prettierrc\""
	},
	"devDependencies": {
		"bun": "1.4.4",
		"eslint-config-prettier": "10.1.8",
		"prettier": "3.9.10"
	}
}
